{
    "name": "avadim/manticore-query-builder-laravel",
    "description": "ManticoreSearch Query Builder for your Laravel applications",
    "keywords": [
        "laravel",
        "manticoresoftware",
        "manticoresearch",
        "manticore",
        "database",
        "query",
        "builder",
        "sql",
        "spinx",
        "spinxql",
        "search"
    ],
    "type": "library",
    "homepage": "https://github.com/aVadim483/manticore-query-builder-laravel",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "psr/log": "^1.1|^2.0|^3.0",
        "avadim/manticore-query-builder-php": "^2.6",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/pagination": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "avadim\\Manticore\\Laravel\\": "./src/Manticore/Laravel"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "avadim\\Manticore\\Laravel\\Tests\\": "./tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "avadim\\Manticore\\Laravel\\ServiceProvider"
            ],
            "aliases": {
                "ManticoreDb": "avadim\\Manticore\\QueryBuilder\\Builder"
            }
        }
    }
}
