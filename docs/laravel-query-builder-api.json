{
    "schema_version": 1,
    "laravel_majors": [
        11,
        12,
        13
    ],
    "scope": "Every public non-static non-magic Query Builder method in supported majors and driver extensions; static Macroable APIs remain framework facilities.",
    "groups": {
        "selection": {
            "status": "supported",
            "notes": "Select columns and a table; aliases and expressions follow native Manticore SQL.",
            "methods": [
                "addSelect",
                "from",
                "select"
            ]
        },
        "predicates": {
            "status": "limited",
            "notes": "Literal comparisons, membership, ranges and nested AND/OR; Unix timestamps for numeric time attributes.",
            "methods": [
                "dynamicWhere",
                "orWhere",
                "orWhereAll",
                "orWhereAny",
                "orWhereBetween",
                "orWhereIn",
                "orWhereIntegerInRaw",
                "orWhereIntegerNotInRaw",
                "orWhereNone",
                "orWhereNot",
                "orWhereNotBetween",
                "orWhereNotIn",
                "where",
                "whereAll",
                "whereAny",
                "whereBetween",
                "whereIn",
                "whereIntegerInRaw",
                "whereIntegerNotInRaw",
                "whereNested",
                "whereNone",
                "whereNot",
                "whereNotBetween",
                "whereNotIn"
            ]
        },
        "nulls": {
            "status": "limited",
            "notes": "JSON paths and document IDs; other attributes depend on native null support. JSON null and missing paths are indistinguishable.",
            "methods": [
                "orWhereNotNull",
                "orWhereNull",
                "whereNotNull",
                "whereNull"
            ]
        },
        "raw-sql": {
            "status": "native-sql",
            "notes": "Explicit SQL escape hatches; the caller supplies Manticore syntax and matching bindings. Server errors are QueryException.",
            "methods": [
                "fromRaw",
                "groupByRaw",
                "havingRaw",
                "orHavingRaw",
                "orWhereRaw",
                "orderByRaw",
                "raw",
                "rawValue",
                "selectExpression",
                "selectRaw",
                "whereRaw"
            ]
        },
        "ordering-windows": {
            "status": "supported",
            "notes": "Native ordering and result windows; cursor/keyset restrictions are documented separately.",
            "methods": [
                "forPage",
                "forPageAfterId",
                "forPageBeforeId",
                "latest",
                "limit",
                "offset",
                "oldest",
                "orderBy",
                "orderByDesc",
                "reorder",
                "reorderDesc",
                "skip",
                "take"
            ]
        },
        "grouping": {
            "status": "limited",
            "notes": "GROUP BY with at most one Basic/Between/Raw HAVING condition; nested HAVING and aggregate-with-HAVING execution are rejected.",
            "methods": [
                "groupBy",
                "having",
                "havingBetween",
                "havingNotBetween",
                "orHaving",
                "orHavingBetween",
                "orHavingNotBetween"
            ]
        },
        "aggregates": {
            "status": "limited",
            "notes": "Native aggregates; DISTINCT is rejected, and aggregate helpers cannot execute queries with HAVING or facets.",
            "methods": [
                "aggregate",
                "average",
                "avg",
                "count",
                "max",
                "min",
                "numericAggregate",
                "sum"
            ]
        },
        "reads": {
            "status": "adapted",
            "notes": "Default Collection/stdClass rows with schema casts; native default is 20 rows unless limited explicitly.",
            "methods": [
                "find",
                "findOr",
                "first",
                "firstOrFail",
                "get",
                "implode",
                "pluck",
                "sole",
                "soleValue",
                "value"
            ]
        },
        "existence": {
            "status": "adapted",
            "notes": "SELECT with LIMIT 1 instead of a SELECT EXISTS subquery; callbacks retain Laravel semantics.",
            "methods": [
                "doesntExist",
                "doesntExistOr",
                "exists",
                "existsOr"
            ]
        },
        "pagination-streaming": {
            "status": "limited",
            "notes": "Native Laravel collections/paginators; cursor, exact counts, groups and keyset restrictions apply.",
            "methods": [
                "chunk",
                "chunkById",
                "chunkByIdDesc",
                "chunkMap",
                "cursor",
                "cursorPaginate",
                "each",
                "eachById",
                "getCountForPagination",
                "lazy",
                "lazyById",
                "lazyByIdDesc",
                "orderedChunkById",
                "paginate",
                "simplePaginate"
            ]
        },
        "writes": {
            "status": "adapted",
            "notes": "Explicit write-shape and payload validation; INSERT uses values, UPDATE changes attributes, DELETE filters documents, TRUNCATE rejects filters.",
            "methods": [
                "delete",
                "insert",
                "insertGetId",
                "truncate",
                "update"
            ]
        },
        "conditional-writes": {
            "status": "adapted",
            "notes": "Read-before-write helpers; full replacement and transactional upsert contracts are documented in write contracts.",
            "methods": [
                "replaceOrInsert",
                "updateOrInsert",
                "upsert"
            ]
        },
        "full-text": {
            "status": "adapted",
            "notes": "whereFullText/orWhereFullText merge escaped field-scoped text into one MATCH; match accepts one top-level native expression.",
            "methods": [
                "escapeMatch",
                "match",
                "orWhereFullText",
                "whereFullText"
            ]
        },
        "json": {
            "status": "adapted",
            "notes": "Array membership, native LENGTH and non-null key semantics; hidden SELECT expressions and deferred bindings.",
            "methods": [
                "orWhereJsonContains",
                "orWhereJsonContainsKey",
                "orWhereJsonDoesntContain",
                "orWhereJsonDoesntContainKey",
                "orWhereJsonDoesntOverlap",
                "orWhereJsonLength",
                "orWhereJsonOverlaps",
                "whereJsonContains",
                "whereJsonContainsKey",
                "whereJsonDoesntContain",
                "whereJsonDoesntContainKey",
                "whereJsonDoesntOverlap",
                "whereJsonLength",
                "whereJsonOverlaps"
            ]
        },
        "search-extensions": {
            "status": "adapted",
            "notes": "Manticore-specific search, metadata, ranking, KNN, geo, facets, highlighting and replacement APIs.",
            "methods": [
                "facet",
                "fieldWeights",
                "getFacets",
                "getMeta",
                "hasKnn",
                "hybridFirst",
                "hybridGet",
                "hybridSearch",
                "knn",
                "option",
                "orWhereMvaAll",
                "orWhereMvaAny",
                "orderByDistance",
                "orderByKnnDistance",
                "ranker",
                "replace",
                "replaceGetId",
                "search",
                "whereGeoDistance",
                "whereMvaAll",
                "whereMvaAny",
                "withDistance",
                "withHighlight",
                "withKnnDistance",
                "withScore"
            ]
        },
        "fetch-modes": {
            "status": "limited",
            "notes": "Laravel 13 get/cursor fetch modes; search, hybrid and conditional-write helpers require default object mode.",
            "methods": [
                "fetchUsing"
            ]
        },
        "composition-debug": {
            "status": "framework",
            "notes": "Laravel composition/debug facilities; user callbacks/macros determine their own behavior.",
            "methods": [
                "dd",
                "ddRawSql",
                "dump",
                "dumpRawSql",
                "macroCall",
                "pipe",
                "tap",
                "unless",
                "when"
            ]
        },
        "bindings-internals": {
            "status": "infrastructure",
            "notes": "Compiled binding getters include deferred MATCH/JSON bindings. Manual merging of deferred search trees is rejected; use nested conditions.",
            "methods": [
                "addBinding",
                "addNestedWhereQuery",
                "afterQuery",
                "applyAfterQueryCallbacks",
                "applyBeforeQueryCallbacks",
                "beforeQuery",
                "castBinding",
                "cleanBindings",
                "cleanSearchRows",
                "clone",
                "cloneWithout",
                "cloneWithoutBindings",
                "forNestedWhere",
                "getBindings",
                "getColumns",
                "getConnection",
                "getGrammar",
                "getLimit",
                "getOffset",
                "getProcessor",
                "getRawBindings",
                "getSearchExpressions",
                "hasQueryCallbacks",
                "mergeBindings",
                "mergeWheres",
                "newQuery",
                "prepareValueAndOperator",
                "processReadRows",
                "setBindings",
                "toRawSql",
                "toSql",
                "useWritePdo"
            ]
        },
        "unsupported": {
            "status": "unsupported",
            "notes": "Explicit rejection before database execution. Methods absent in a Laravel major are not backported. timeout(null) clears the setting; empty write inputs can be no-ops.",
            "methods": [
                "addNestedHavingQuery",
                "addWhereExistsQuery",
                "crossJoin",
                "crossJoinSub",
                "decrement",
                "decrementEach",
                "distinct",
                "explain",
                "forceIndex",
                "fromSub",
                "groupLimit",
                "havingNested",
                "havingNotNull",
                "havingNull",
                "ignoreIndex",
                "inOrderOf",
                "inRandomOrder",
                "increment",
                "incrementEach",
                "insertOrIgnore",
                "insertOrIgnoreReturning",
                "insertOrIgnoreUsing",
                "insertUsing",
                "join",
                "joinLateral",
                "joinSub",
                "joinWhere",
                "leftJoin",
                "leftJoinLateral",
                "leftJoinSub",
                "leftJoinWhere",
                "lock",
                "lockForUpdate",
                "orHavingNotNull",
                "orHavingNull",
                "orWhereAfterToday",
                "orWhereBeforeToday",
                "orWhereBetweenColumns",
                "orWhereBinary",
                "orWhereColumn",
                "orWhereDate",
                "orWhereDay",
                "orWhereExists",
                "orWhereFuture",
                "orWhereLike",
                "orWhereMonth",
                "orWhereNotBetweenColumns",
                "orWhereNotBinary",
                "orWhereNotExists",
                "orWhereNotLike",
                "orWhereNowOrFuture",
                "orWhereNowOrPast",
                "orWhereNullSafeEquals",
                "orWherePast",
                "orWhereRowValues",
                "orWhereTime",
                "orWhereToday",
                "orWhereTodayOrAfter",
                "orWhereTodayOrBefore",
                "orWhereValueBetween",
                "orWhereValueNotBetween",
                "orWhereVectorDistanceLessThan",
                "orWhereYear",
                "orderByVectorDistance",
                "rightJoin",
                "rightJoinSub",
                "rightJoinWhere",
                "selectSub",
                "selectVectorDistance",
                "sharedLock",
                "straightJoin",
                "straightJoinSub",
                "straightJoinWhere",
                "timeout",
                "union",
                "unionAll",
                "updateFrom",
                "useIndex",
                "whereAfterToday",
                "whereBeforeToday",
                "whereBetweenColumns",
                "whereBinary",
                "whereColumn",
                "whereDate",
                "whereDay",
                "whereExists",
                "whereFuture",
                "whereLike",
                "whereMonth",
                "whereNotBetweenColumns",
                "whereNotBinary",
                "whereNotExists",
                "whereNotLike",
                "whereNowOrFuture",
                "whereNowOrPast",
                "whereNullSafeEquals",
                "wherePast",
                "whereRowValues",
                "whereTime",
                "whereToday",
                "whereTodayOrAfter",
                "whereTodayOrBefore",
                "whereValueBetween",
                "whereValueNotBetween",
                "whereVectorDistanceLessThan",
                "whereVectorSimilarTo",
                "whereYear"
            ]
        }
    }
}
